# 源代码文件
**/*.ts
**/tsconfig.json

# 扩展主代码已打包到 out/extension.js，src 下只剩 Webview 模板/资源需要打包
src/**
!src/templates/**
!src/lib/**
!src/resources/**

# 开发和构建文件
.vscode/**
.vscode-test/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/.eslintrc.json
**/.eslintrc.js
**/.eslintrc.yaml
**/.eslintrc.yml
**/.eslintrc
**/tslint.json

# 依赖文件
# 注意：不要排除 node_modules/，vsce 需要它来打包 dependencies 中的包
# vsce 会自动只打包 dependencies 中的包，不会打包 devDependencies
package-lock.json
yarn.lock

# 测试文件
**/test/**
**/*.test.ts
**/*.test.js

# 文档和说明文件（保留README.md和CHANGELOG.md）
**/images/icon-instructions.md
PUBLISH_GUIDE.md
DETAILED_DEBUG.md
UPDATED_TEST_GUIDE.md
TAG_USAGE.md
QUICK_TEST.md
SMART_MATCHING.md
STORAGE_GUIDE.md
DEBUG_GUIDE.md
test-*.js
test-*.ts

# 临时文件
**/*.map
**/*.vsix

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 计划文档目录
planning/**

# 排除 GIF 文件
**/*.gif 

# 功能截图（仅保留扩展图标）
# README / CHANGELOG 中的截图均使用 GitHub 绝对 URL，
# 无需将本地图片打进 vsix；仅需保留 icon.png 与 activity-bar.svg
!images/icon.png
!images/activity-bar.svg
images/*.png
images/*.jpg

# AI 代理/编辑器配置与技能目录，运行时不需要
.cursor/**
.opencode/**

# GitHub 工作流与配置，运行时不需要
.github/**

# 文档站点与开发文档，运行时不需要
website/**
docs/**

# 构建脚本，运行时不需要
scripts/**